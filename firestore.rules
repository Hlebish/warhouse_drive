rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isDriver() {
      return request.auth != null && request.auth.token.driver == true;
    }
    match /clients/{clientId} {
      allow read, create, update, delete: if isDriver();
    }
    // PIN rate limits are written only by trusted Cloud Functions/Admin SDK.
    match /pinAttempts/{attemptId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
